<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">


    <!-- الصف العلوي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">


        <!-- المربع 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/q1_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/devlopers_around_the_world"
                android:textColor="@color/q1_title"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/programmers_create_software_and_technology_that_make_life_easier_and_more_connected"
                android:textColor="@color/q1_desc"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- المربع 2 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/q2_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cybersecurity_engineers"
                android:textColor="@color/q2_title"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/cybersecurity_engineers_protect_computer_systems_and_networks_from_cyber_threats_they_help_keep_data_safe_by_preventing_attacks_and_securing_digital_information"
                android:textColor="@color/q2_desc"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- الصف السفلي -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- المربع 3 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/q3_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/software_engineers"
                android:textColor="@color/q3_title"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/software_engineers_design_develop_and_maintain_software_applications_they_use_programming_skills_to_create_efficient_solutions_that_help_people_and_businesses_solve_problems"
                android:textColor="@color/q3_desc"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- المربع 4 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/q4_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/text7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/web_developers"
                android:textColor="@color/q4_title"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/web_developers_create_and_maintain_websites_to_ensure_they_are_functional_user_friendly_and_visually_appealing_they_use_programming_languages_to_build_the_modern_web"
                android:textColor="@color/q4_desc"
                android:textSize="18sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>